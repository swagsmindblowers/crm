{
	"name": "mcp",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "bun build src/main.ts --target=bun --outdir dist --packages=external --sourcemap",
		"check-types": "tsc --noEmit",
		"dev": "bun --watch src/main.ts",
		"lint": "biome check .",
		"start": "bun src/main.ts",
		"start:prod": "bun dist/main.js",
		"test": "CRM_TELEMETRY_DISABLED=1 MCP_OAUTH_SECRET=test-secret-do-not-use-in-production bun test",
		"clean": "rm -rf .turbo dist node_modules"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.10.1",
		"typescript": "5.9.2"
	}
}
